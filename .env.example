# AI + news backend wiring (all optional — the app works without them).
#
# NEVER put secrets here or in any VITE_* variable. These are plain HTTPS
# endpoint URLs for YOUR OWN server-side functions that hold provider keys.
# Leave empty to use the built-in deterministic local explainer + empty news.

# POSTs { system, user, input } and expects the validated analysis JSON
# (or { "analysis": { ... } }). Must be https:// and must allow CORS.
VITE_AI_ENDPOINT=

# GETs ?symbol=OP (or POSTs { symbol }) and expects a JSON array of news items:
# [{ id, headline, source, url, publishedAt(ms), symbol, summary, sentiment }]
VITE_NEWS_ENDPOINT=

# POSTs { message, symbol, direction } from YOUR OWN server-side function that
# holds the Telegram bot token. The browser never sees any token. Leave empty
# for "Not configured" status (in-app + browser alerts still work).
VITE_TELEGRAM_ENDPOINT=

# --- Gemini AI explanations (optional; local explainer is the default) ---
# The browser NEVER holds the Gemini key. Point this at YOUR OWN secure
# backend (Supabase Edge Function `explain-signal`, see
# supabase/functions/explain-signal/) which calls Gemini server-side.
# Leave empty to use the built-in deterministic local explainer.
VITE_AI_ENDPOINT=https://dzcwpaegqvhigceuxiop.supabase.co/functions/v1/explain-signal

# Server-side ONLY (Supabase secrets or your host env). NEVER prefix with
# VITE_*, NEVER commit it, NEVER put it in frontend code.
# Set via: supabase secrets set GEMINI_API_KEY=<key>
# GEMINI_API_KEY=

# --- Supabase cloud paper trading (optional; app works locally without it) ---
# NEVER put sb_secret_* / service_role keys here or in any VITE_* variable.
# Frontend uses ONLY the publishable key (safe for browsers, RLS enforced).
VITE_SUPABASE_URL=https://dzcwpaegqvhigceuxiop.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
